<UserControl x:Class="SinUpdateHub.App.Views.NotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:SinUpdateHub.App.Views"
             xmlns:vm="clr-namespace:SinUpdateHub.App.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1180"
             d:DesignHeight="760"
             Focusable="True"
             Background="Transparent"
             PreviewMouseDown="NotesView_PreviewMouseDown"
             PreviewKeyDown="NotesView_PreviewKeyDown">

    <UserControl.Resources>
        <Style x:Key="NoteSwatchButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderBrush" Value="#70FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                SnapsToDevicePixels="True" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFFFFFFF" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="195" />
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== Column 0：分区列表 ==================== -->
        <Border Grid.Column="0"
                Background="{StaticResource BrushBg1}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 分区头部 + 新建分区按钮 -->
                <Border Grid.Row="0"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="0,0,0,1"
                        Padding="12,10">
                    <Grid>
                        <TextBlock Text="分区"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushText}"
                                   VerticalAlignment="Center" />
                        <Button Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Right"
                                MinHeight="28"
                                Height="28"
                                Padding="8,0"
                                FontSize="12"
                                Command="{Binding AddSectionCommand}"
                                AutomationProperties.Name="新建分区">
                            <TextBlock Text="+ 新建分区" VerticalAlignment="Center" />
                        </Button>
                    </Grid>
                </Border>

                <!-- 分区 ListBox -->
                <ListBox Grid.Row="1"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="6,8"
                         ItemsSource="{Binding Sections}"
                         SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="分区列表">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,3" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Cursor" Value="Hand" />
                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="ListBoxItem_PreviewMouseRightButtonDown" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                        <Border x:Name="Bd"
                                                Background="Transparent"
                                                CornerRadius="6"
                                                Padding="8,7"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushBg2}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushAccentSoft}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Background="Transparent">
                                <Grid.ContextMenu>
                                    <ContextMenu Style="{StaticResource DarkContextMenu}">
                                        <MenuItem Style="{StaticResource DarkMenuItem}"
                                                  Header="重命名分区"
                                                  Command="{Binding Owner.RenameSectionCommand}"
                                                  CommandParameter="{Binding}" />
                                        <MenuItem Style="{StaticResource DarkMenuItem}"
                                                  Header="删除分区"
                                                  Command="{Binding Owner.DeleteSectionCommand}"
                                                  CommandParameter="{Binding}" />
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="4"
                                        Height="18"
                                        CornerRadius="2"
                                        Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center" />

                                <TextBlock Grid.Column="1"
                                           Text="{Binding Name}"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Foreground="{StaticResource BrushText}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />

                                <TextBlock Grid.Column="2"
                                           Text="{Binding PageCountText}"
                                           FontSize="11"
                                           Foreground="{StaticResource BrushTextMuted}"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 选中分区快捷操作与颜色点 -->
                <Border Grid.Row="2"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="0,1,0,0"
                        Padding="10,8"
                        Visibility="{Binding HasSelectedSection, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="当前分区色"
                                   FontSize="11"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   Margin="0,0,0,6" />

                        <ItemsControl ItemsSource="{x:Static vm:NotesViewModel.SectionColorPresets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="16"
                                            Height="16"
                                            Margin="0,0,5,4"
                                            Cursor="Hand"
                                            ToolTip="{Binding Name}"
                                            Command="{Binding DataContext.ChangeSectionColorCommand, RelativeSource={RelativeSource AncestorType={x:Type views:NotesView}}}"
                                            CommandParameter="{Binding Hex}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Border CornerRadius="4"
                                                        BorderBrush="#50FFFFFF"
                                                        BorderThickness="1"
                                                        Background="{Binding Hex, Converter={StaticResource HexToBrush}}" />
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 回收站入口（始终可见，便于全部删除后仍可找回） -->
                <Border Grid.Row="3"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="0,1,0,0"
                        Padding="8,8">
                    <Button Style="{StaticResource GhostButton}"
                            Height="30"
                            MinHeight="30"
                            Padding="10,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Command="{Binding OpenTrashCommand}"
                            AutomationProperties.Name="回收站">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ButtonGlyph}" Text="&#xE74D;" />
                            <TextBlock Text="{Binding TrashButtonText}" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== Column 1：页列表 ==================== -->
        <Border Grid.Column="1"
                Background="{StaticResource BrushBg0}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 添加页 / 新建表格页 -->
                <Border Grid.Row="0"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="0,0,0,1"
                        Padding="10,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{StaticResource SecondaryButton}"
                                MinHeight="28"
                                Height="28"
                                Padding="6,0"
                                FontSize="12"
                                Command="{Binding AddPageCommand}"
                                AutomationProperties.Name="添加页">
                            <TextBlock Text="+ 添加页" />
                        </Button>

                        <Button Grid.Column="2"
                                Style="{StaticResource GhostButton}"
                                MinHeight="28"
                                Height="28"
                                Padding="6,0"
                                FontSize="12"
                                Command="{Binding AddTablePageCommand}"
                                ToolTip="新建并直接带入一个 3×3 表格"
                                AutomationProperties.Name="新建表格页">
                            <TextBlock Text="+ 表格页" />
                        </Button>
                    </Grid>
                </Border>

                <!-- 页 ListBox -->
                <ListBox Grid.Row="1"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="6,8"
                         ItemsSource="{Binding SelectedSection.Pages}"
                         SelectedItem="{Binding SelectedPage, Mode=TwoWay}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="页列表">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,3" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Cursor" Value="Hand" />
                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="ListBoxItem_PreviewMouseRightButtonDown" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                        <Grid Margin="0">
                                            <Border x:Name="Bd"
                                                    Background="Transparent"
                                                    CornerRadius="6"
                                                    Padding="10,8"
                                                    SnapsToDevicePixels="True">
                                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                            </Border>
                                            <Border x:Name="Bar"
                                                    Width="3"
                                                    Height="18"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Margin="2,0,0,0"
                                                    CornerRadius="1.5"
                                                    Background="{StaticResource BrushAccent}"
                                                    Visibility="Collapsed" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushBg2}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushAccentSoft}" />
                                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Background="Transparent">
                                <StackPanel.ContextMenu>
                                    <ContextMenu Style="{StaticResource DarkContextMenu}">
                                        <MenuItem Style="{StaticResource DarkMenuItem}"
                                                  Header="重命名页"
                                                  Command="{Binding Owner.RenamePageCommand}"
                                                  CommandParameter="{Binding}" />
                                        <MenuItem Style="{StaticResource DarkMenuItem}"
                                                  Header="删除页"
                                                  Command="{Binding Owner.DeletePageCommand}"
                                                  CommandParameter="{Binding}" />
                                    </ContextMenu>
                                </StackPanel.ContextMenu>
                                <TextBlock Text="{Binding Title}"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Foreground="{StaticResource BrushText}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding ShortDateText}"
                                           FontSize="11"
                                           Foreground="{StaticResource BrushTextMuted}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- ==================== Column 2：页编辑画布 ==================== -->
        <Grid Grid.Column="2" Background="{StaticResource BrushBg0}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 空状态引导 -->
            <StackPanel Grid.Row="0"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Margin="32"
                        Visibility="{Binding HasNoSelectedPage, Converter={StaticResource BoolToVis}}">
                <Border Width="54"
                        Height="54"
                        CornerRadius="14"
                        Background="{StaticResource BrushBg1}"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,14">
                    <TextBlock Text="&#xE70B;"
                               FontFamily="{StaticResource FontFamilyIcon}"
                               FontSize="22"
                               Foreground="{StaticResource BrushAccent}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="SinNote 表格与笔记"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource BrushText}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="按「分区 → 页 → 表格 / 内容」保存表格与截图，所有内容都会自动随 WebDAV 备份与恢复"
                           FontSize="12"
                           Foreground="{StaticResource BrushTextSecondary}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           MaxWidth="420"
                           Margin="0,6,0,18" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource PrimaryButton}"
                            Command="{Binding AddTablePageCommand}"
                            Content="+ 新建表格页 (3×3)" />
                    <Button Style="{StaticResource SecondaryButton}"
                            Margin="10,0,0,0"
                            Command="{Binding AddPageCommand}"
                            Content="+ 新建空白页" />
                </StackPanel>
            </StackPanel>

            <!-- 页编辑器（Typora 风格离线 Vditor IR + WebView2） -->
            <Grid Grid.Row="0" Visibility="{Binding HasSelectedPage, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 页标题、日期、查找框与删除页（顶部冗余工具栏已内聚到 Vditor 工具栏尾部） -->
                <Grid Grid.Row="0" Margin="24,14,20,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBox x:Name="PageTitleTextBox"
                                 Text="{Binding SelectedPage.Title, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent"
                                 Foreground="{StaticResource BrushText}"
                                 CaretBrush="{StaticResource BrushText}"
                                 SelectionBrush="{StaticResource BrushAccent}"
                                 IsInactiveSelectionHighlightEnabled="True"
                                 BorderBrush="{StaticResource BrushBorderStrong}"
                                 BorderThickness="0,0,0,1"
                                 FontSize="22"
                                 FontWeight="SemiBold"
                                 Padding="2,2,2,6"
                                 HorizontalAlignment="Stretch"
                                 MinWidth="200"
                                 AutomationProperties.Name="页标题" />
                        <TextBlock Text="{Binding SelectedPage.DateLineText}"
                                   FontSize="12"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   Margin="2,5,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Top"
                                Margin="16,2,0,0">
                        <!-- 查找框（Ctrl+F 本页 / Ctrl+E 全部分区；采用 3 列 Grid + 无内边距 TextBox，彻底消除双重 Padding 挤文字） -->
                        <Grid x:Name="SearchBoxContainer" Width="270" Height="32">
                            <Border x:Name="SearchBoxBorder"
                                    Background="{StaticResource BrushBg1}"
                                    BorderBrush="{StaticResource BrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    SnapsToDevicePixels="True">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=NoteSearchBox}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="&#xE721;"
                                               FontFamily="{StaticResource FontFamilyIcon}"
                                               FontSize="12"
                                               Foreground="{StaticResource BrushTextMuted}"
                                               VerticalAlignment="Center"
                                               Margin="10,0,7,0"
                                               IsHitTestVisible="False" />

                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                        <TextBox x:Name="NoteSearchBox"
                                                 Background="Transparent"
                                                 Foreground="{StaticResource BrushText}"
                                                 CaretBrush="{StaticResource BrushText}"
                                                 SelectionBrush="{StaticResource BrushAccent}"
                                                 BorderThickness="0"
                                                 Padding="0"
                                                 FontSize="12.5"
                                                 VerticalAlignment="Center"
                                                 VerticalContentAlignment="Center"
                                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 GotKeyboardFocus="NoteSearchBox_GotKeyboardFocus"
                                                 PreviewKeyDown="NoteSearchBox_PreviewKeyDown"
                                                 AutomationProperties.Name="查找笔记内容" />

                                        <TextBlock Text="查找 (Ctrl+F / Ctrl+E)"
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource BrushTextMuted}"
                                                   VerticalAlignment="Center"
                                                   Margin="1,0,0,0"
                                                   IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="Visibility" Value="{Binding SearchText, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=NoteSearchBox}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>

                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="6,0,5,0">
                                        <TextBlock Text="{Binding MatchProgressText}"
                                                   FontSize="10.5"
                                                   Foreground="{StaticResource BrushTextMuted}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,3,0"
                                                   Visibility="{Binding SearchText, Converter={StaticResource NullToVis}}" />
                                        <Button Style="{StaticResource IconButtonTiny}"
                                                Width="18"
                                                Height="22"
                                                Focusable="False"
                                                Content="&#xE70E;"
                                                FontSize="9"
                                                ToolTip="上一处 (Shift+Enter)"
                                                Command="{Binding PrevSearchMatchCommand}"
                                                Visibility="{Binding HasSearchResults, Converter={StaticResource BoolToVis}}" />
                                        <Button Style="{StaticResource IconButtonTiny}"
                                                Width="18"
                                                Height="22"
                                                Focusable="False"
                                                Content="&#xE70D;"
                                                FontSize="9"
                                                ToolTip="下一处 (Enter)"
                                                Command="{Binding NextSearchMatchCommand}"
                                                Visibility="{Binding HasSearchResults, Converter={StaticResource BoolToVis}}" />
                                        <Button Style="{StaticResource IconButtonTiny}"
                                                Width="20"
                                                Height="22"
                                                Focusable="False"
                                                Content="&#xE711;"
                                                FontSize="9"
                                                ToolTip="清除查找"
                                                Command="{Binding ClearSearchCommand}"
                                                Visibility="{Binding SearchText, Converter={StaticResource NullToVis}}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 查找结果下拉浮层（参考 OneNote） -->
                            <Popup x:Name="SearchResultsPopup"
                                   PlacementTarget="{Binding ElementName=SearchBoxContainer}"
                                   Placement="Bottom"
                                   HorizontalOffset="-160"
                                   VerticalOffset="4"
                                   StaysOpen="True"
                                   AllowsTransparency="True"
                                   IsOpen="{Binding IsSearchDropdownOpen, Mode=TwoWay}">
                                <Border x:Name="SearchPopupBorder"
                                        Background="{StaticResource BrushBg1}"
                                        BorderBrush="{StaticResource BrushBorderStrong}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12"
                                        Width="430">
                                    <StackPanel>
                                        <!-- 顶行：状态说明 + 切换范围链接 -->
                                        <Grid Margin="0,0,0,8">
                                            <TextBlock Text="{Binding SearchHeaderText}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource BrushTextSecondary}"
                                                       VerticalAlignment="Center" />
                                            <Button Style="{StaticResource GhostButton}"
                                                    HorizontalAlignment="Right"
                                                    Focusable="False"
                                                    MinHeight="24"
                                                    Height="24"
                                                    Padding="6,0"
                                                    FontSize="11"
                                                    Foreground="{StaticResource BrushInfo}"
                                                    Content="{Binding SwitchScopeLinkText}"
                                                    Command="{Binding ToggleSearchScopeCommand}" />
                                        </Grid>

                                        <TextBlock Text="没有找到匹配的内容"
                                                   FontSize="12"
                                                   Foreground="{StaticResource BrushTextMuted}"
                                                   Margin="2,6,2,6"
                                                   Visibility="{Binding HasSearchResults, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />

                                        <ScrollViewer MaxHeight="320"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      Visibility="{Binding HasSearchResults, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl ItemsSource="{Binding SearchResults}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Focusable="False"
                                                                Cursor="Hand"
                                                                Margin="0,0,0,3"
                                                                Command="{Binding DataContext.SelectSearchResultCommand, RelativeSource={RelativeSource AncestorType={x:Type views:NotesView}}}"
                                                                CommandParameter="{Binding}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="{x:Type Button}">
                                                                    <Border x:Name="Bd"
                                                                            Background="Transparent"
                                                                            CornerRadius="6"
                                                                            Padding="8,6">
                                                                        <Grid>
                                                                            <Grid.RowDefinitions>
                                                                                <RowDefinition Height="Auto" />
                                                                                <RowDefinition Height="Auto" />
                                                                            </Grid.RowDefinitions>
                                                                            <Grid Grid.Row="0">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                    <ColumnDefinition Width="*" />
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <Path Grid.Column="0"
                                                                                      Data="M14,2H6C4.9,2,4,2.9,4,4v16c0,1.1,0.9,2,2,2h12c1.1,0,2-0.9,2-2V8L14,2z M13,9V3.5L18.5,9H13z M8,13h8v1.5H8V13z M8,16h6v1.5H8V16z"
                                                                                      Fill="{StaticResource BrushAccent}"
                                                                                      Width="12"
                                                                                      Height="12"
                                                                                      Stretch="Uniform"
                                                                                      VerticalAlignment="Center"
                                                                                      Margin="0,0,7,0" />
                                                                                <TextBlock Grid.Column="1"
                                                                                           Text="{Binding PageTitle}"
                                                                                           FontSize="13"
                                                                                           FontWeight="SemiBold"
                                                                                           Foreground="{StaticResource BrushText}"
                                                                                           TextTrimming="CharacterEllipsis"
                                                                                           VerticalAlignment="Center" />
                                                                                <Border Grid.Column="2"
                                                                                        Background="{StaticResource BrushBg3}"
                                                                                        CornerRadius="3"
                                                                                        Padding="5,1"
                                                                                        Margin="6,0,6,0"
                                                                                        VerticalAlignment="Center">
                                                                                    <TextBlock Text="{Binding SourceTag}"
                                                                                               FontSize="10"
                                                                                               Foreground="{StaticResource BrushTextSecondary}" />
                                                                                </Border>
                                                                                <TextBlock Grid.Column="3"
                                                                                           Text="{Binding SectionDisplay}"
                                                                                           FontSize="11"
                                                                                           Foreground="{StaticResource BrushTextMuted}"
                                                                                           VerticalAlignment="Center" />
                                                                            </Grid>
                                                                            <TextBlock Grid.Row="1"
                                                                                       Text="{Binding Snippet}"
                                                                                       FontSize="11"
                                                                                       Foreground="{StaticResource BrushTextSecondary}"
                                                                                       TextTrimming="CharacterEllipsis"
                                                                                       Margin="19,3,0,0" />
                                                                        </Grid>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushBg2}" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- Typora 风格离线 Markdown 正文编辑区 -->
                <views:MarkdownNoteEditor x:Name="MarkdownEditor"
                                          Grid.Row="1"
                                          Margin="0,2,0,0" />
            </Grid>

            <!-- 底部状态条 -->
            <Border Grid.Row="1"
                    Background="{StaticResource BrushBg1}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="0,1,0,0"
                    Padding="20,7">
                <Grid>
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="12"
                               Foreground="{StaticResource BrushInfo}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="Ctrl+滚轮 缩放画布 · 单击图片选中后按退格删除 / 双击放大 · Ctrl+F/E 查找"
                               FontSize="11"
                               Foreground="{StaticResource BrushTextMuted}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
