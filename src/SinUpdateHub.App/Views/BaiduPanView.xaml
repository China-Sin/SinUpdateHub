<UserControl x:Class="SinUpdateHub.App.Views.BaiduPanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:SinUpdateHub.App.Controls"
             mc:Ignorable="d"
             d:DesignWidth="1160"
             d:DesignHeight="760"
             Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="24,18,24,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Style="{StaticResource PageTitle}" Text="百度网盘" />
                <TextBlock Style="{StaticResource PageSubtitle}" Text="手动填入你在百度网盘开放平台创建的 AppKey / SecretKey，登录后即可浏览并一键下载指定文件夹内容" />
            </StackPanel>

            <!-- 顶部配置与账号登录卡片 -->
            <Border Grid.Row="1"
                    Background="{StaticResource BrushBg1}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16,14"
                    Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- AppKey -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="AppKey（手动填写）" />
                            <TextBox Style="{StaticResource InputBox}"
                                     Text="{Binding AppKey, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="百度网盘 AppKey" />
                        </StackPanel>

                        <!-- SecretKey -->
                        <StackPanel Grid.Column="2">
                            <Grid>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="SecretKey（本地 DPAPI 加密保存）" />
                                <CheckBox Style="{StaticResource InputCheck}"
                                          Content="显示"
                                          IsChecked="{Binding ShowSecretKey}"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          FontSize="11" />
                            </Grid>
                            <Grid>
                                <PasswordBox Style="{StaticResource InputPassword}"
                                             controls:PasswordBoxHelper.BindPassword="{Binding SecretKey, Mode=TwoWay}"
                                             AutomationProperties.Name="百度网盘 SecretKey"
                                             Visibility="{Binding ShowSecretKey, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                <TextBox Style="{StaticResource InputBox}"
                                         Text="{Binding SecretKey, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="百度网盘 SecretKey 明文"
                                         Visibility="{Binding ShowSecretKey, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </StackPanel>

                        <!-- 按钮组 -->
                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button Style="{StaticResource SecondaryButton}"
                                    Command="{Binding SaveConfigCommand}"
                                    AutomationProperties.Name="保存密钥">
                                <TextBlock Text="保存密钥" VerticalAlignment="Center" />
                            </Button>
                            <Button Style="{StaticResource PrimaryButton}"
                                    Margin="8,0,0,0"
                                    Command="{Binding LoginCommand}"
                                    AutomationProperties.Name="登录百度网盘">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource ButtonGlyph}" Text="&#xE77B;" />
                                    <TextBlock Text="登录百度网盘" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource DangerGhostButton}"
                                    Margin="8,0,0,0"
                                    Command="{Binding LogoutCommand}"
                                    Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}"
                                    AutomationProperties.Name="退出登录">
                                <TextBlock Text="退出" VerticalAlignment="Center" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- 账号状态与开放平台链接 -->
                    <Grid Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="账号状态："
                                       FontSize="11.5"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding AccountStatusText}"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushText}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="  ·  个人应用默认可访问网盘 /apps/SinUpdateHub/ 下的文件夹"
                                       FontSize="11.5"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <Button Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Right"
                                Height="24"
                                MinHeight="24"
                                Padding="8,0"
                                Command="{Binding OpenConsoleCommand}"
                                AutomationProperties.Name="打开百度开放平台控制台">
                            <TextBlock Text="打开百度开放平台控制台 →" FontSize="11" VerticalAlignment="Center" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 网盘目录浏览与下载主卡片 -->
            <Border Grid.Row="2"
                    Background="{StaticResource BrushBg1}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 网盘路径栏 -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="网盘路径："
                                   FontSize="12"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBox Grid.Column="1"
                                 Style="{StaticResource InputBox}"
                                 Text="{Binding CurrentDir, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="DirBox_KeyDown"
                                 AutomationProperties.Name="网盘目录路径" />
                        <Button Grid.Column="2"
                                Style="{StaticResource SecondaryButton}"
                                Margin="8,0,0,0"
                                Command="{Binding NavigateDirCommand}"
                                AutomationProperties.Name="进入目录">
                            <TextBlock Text="进入" VerticalAlignment="Center" />
                        </Button>
                        <Button Grid.Column="3"
                                Style="{StaticResource GhostButton}"
                                Margin="6,0,0,0"
                                Command="{Binding GoParentCommand}"
                                AutomationProperties.Name="上级目录">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource ButtonGlyph}" Text="&#xE74A;" />
                                <TextBlock Text="上级" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="4"
                                Style="{StaticResource GhostButton}"
                                Margin="6,0,0,0"
                                Command="{Binding RefreshCommand}"
                                AutomationProperties.Name="刷新目录">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource ButtonGlyph}" Text="&#xE72C;" />
                                <TextBlock Text="刷新" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- 本地保存目录 + 操作按钮 -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="保存到："
                                   FontSize="12"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBox Grid.Column="1"
                                 Style="{StaticResource InputBox}"
                                 Text="{Binding LocalDownloadDir, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="本地下载目录" />
                        <Button Grid.Column="2"
                                Style="{StaticResource GhostButton}"
                                Margin="8,0,0,0"
                                Command="{Binding ChooseDownloadDirCommand}"
                                AutomationProperties.Name="选择保存目录">
                            <TextBlock Text="浏览…" VerticalAlignment="Center" />
                        </Button>
                        <Button Grid.Column="3"
                                Style="{StaticResource GhostButton}"
                                Margin="6,0,0,0"
                                Command="{Binding OpenDownloadDirCommand}"
                                AutomationProperties.Name="打开保存目录">
                            <TextBlock Text="打开目录" VerticalAlignment="Center" />
                        </Button>
                    </Grid>

                    <!-- 文件列表 -->
                    <Border Grid.Row="2"
                            Background="{StaticResource BrushBg0}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="4">
                        <Grid>
                            <ListBox x:Name="FileListBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ItemsSource="{Binding Items}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     MouseDoubleClick="FileListBox_MouseDoubleClick"
                                     AutomationProperties.Name="百度网盘文件列表">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="{x:Type ListBoxItem}">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{StaticResource BrushText}" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,1" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                    <Border x:Name="Bd"
                                                            Background="Transparent"
                                                            CornerRadius="6"
                                                            Padding="10,7"
                                                            SnapsToDevicePixels="True">
                                                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushBg2}" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushAccentSoft}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="130" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0"
                                                      Style="{StaticResource InputCheck}"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,10,0" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Glyph}"
                                                       FontFamily="{StaticResource FontFamilyIcon}"
                                                       FontSize="14"
                                                       Foreground="{StaticResource BrushAccent}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Name}"
                                                       FontSize="13"
                                                       Foreground="{StaticResource BrushText}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding TypeText}"
                                                       FontSize="11.5"
                                                       Foreground="{StaticResource BrushTextMuted}"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0" />
                                            <TextBlock Grid.Column="4"
                                                       Text="{Binding SizeText}"
                                                       FontSize="11.5"
                                                       Foreground="{StaticResource BrushTextSecondary}"
                                                       TextAlignment="Right"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="5"
                                                       Text="{Binding ModifiedText}"
                                                       FontSize="11.5"
                                                       Foreground="{StaticResource BrushTextMuted}"
                                                       TextAlignment="Right"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- 空状态提示 -->
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False"
                                        Visibility="{Binding HasNoItems, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="&#xE8B7;"
                                           FontFamily="{StaticResource FontFamilyIcon}"
                                           FontSize="30"
                                           Foreground="{StaticResource BrushTextMuted}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding ItemCountText}"
                                           FontSize="13"
                                           Foreground="{StaticResource BrushTextSecondary}"
                                           HorizontalAlignment="Center"
                                           Margin="0,8,0,2" />
                                <TextBlock Text="双击文件夹可进入子目录，支持勾选下载或一键下载当前文件夹全部内容"
                                           FontSize="11.5"
                                           Foreground="{StaticResource BrushTextMuted}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 底部操作条 + 下载进度 -->
                    <StackPanel Grid.Row="3" Margin="0,12,0,0">
                        <Grid Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}" Margin="0,0,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0"
                                       Text="{Binding DownloadProgressText}"
                                       FontSize="11.5"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,0,0,5" />
                            <ProgressBar Grid.Row="1"
                                         Height="6"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding DownloadProgressPercent}"
                                         Foreground="{StaticResource BrushAccent}"
                                         Background="{StaticResource BrushBg2}"
                                         BorderThickness="0" />
                        </Grid>

                        <Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button Style="{StaticResource GhostButton}"
                                        Command="{Binding SelectAllCommand}"
                                        AutomationProperties.Name="全选">
                                    <TextBlock Text="全选" VerticalAlignment="Center" />
                                </Button>
                                <Button Style="{StaticResource GhostButton}"
                                        Margin="6,0,0,0"
                                        Command="{Binding ClearSelectionCommand}"
                                        AutomationProperties.Name="取消全选">
                                    <TextBlock Text="取消全选" VerticalAlignment="Center" />
                                </Button>
                                <TextBlock Text="{Binding ItemCountText}"
                                           FontSize="11.5"
                                           Foreground="{StaticResource BrushTextMuted}"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource DangerGhostButton}"
                                        Margin="0,0,8,0"
                                        Command="{Binding CancelDownloadCommand}"
                                        Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}"
                                        AutomationProperties.Name="取消下载">
                                    <TextBlock Text="取消下载" VerticalAlignment="Center" />
                                </Button>
                                <Button Style="{StaticResource SecondaryButton}"
                                        Command="{Binding DownloadSelectedCommand}"
                                        AutomationProperties.Name="下载选中项">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource ButtonGlyph}" Text="&#xE896;" />
                                        <TextBlock Text="下载选中项" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource PrimaryButton}"
                                        Margin="8,0,0,0"
                                        Command="{Binding DownloadCurrentFolderCommand}"
                                        AutomationProperties.Name="下载当前文件夹全部">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource ButtonGlyph}" Text="&#xE896;" />
                                        <TextBlock Text="下载当前文件夹全部" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="1"
                Background="{StaticResource BrushBg1}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,1,0,0"
                Padding="24,8">
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="12"
                       Foreground="{StaticResource BrushTextSecondary}"
                       TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</UserControl>
