<Window x:Class="SinUpdateHub.App.Views.PackageSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="搜索 WinGet 包 ID"
        Width="760"
        Height="640"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource BrushBg0}"
        Style="{StaticResource WindowBaseStyle}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 搜索结果行：内容横向拉伸（右侧版本号贴边） -->
        <Style x:Key="SearchResultItem" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Grid Background="Transparent" Margin="0,0,0,2">
                            <Border x:Name="Bg" CornerRadius="6" Background="Transparent" />
                            <Border x:Name="Bar"
                                    Width="2"
                                    HorizontalAlignment="Left"
                                    Margin="2,6"
                                    CornerRadius="1"
                                    Background="{StaticResource BrushAccent}"
                                    Visibility="Collapsed" />
                            <ContentPresenter Margin="12,8"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Stretch" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushBg2}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushAccentSoft}" />
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource BrushBg0}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== 标题栏 ==================== -->
        <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="16,0,0,0">
                <Border Width="22" Height="22" CornerRadius="6" Background="{StaticResource BrushAccentGradient}">
                    <TextBlock Text="S"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="搜索 WinGet 包 ID"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource BrushText}"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0">
                <Button Style="{StaticResource CloseTitleBarButton}"
                        Content="&#xE711;"
                        ToolTip="关闭"
                        AutomationProperties.Name="关闭"
                        Click="BtnClose_Click" />
            </StackPanel>
        </Grid>

        <!-- ==================== 内容 ==================== -->
        <Grid Grid.Row="1" Margin="24,10,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 说明 -->
            <TextBlock Grid.Row="0"
                       Text="输入软件名称或关键词（如 UU远程、微信、7zip、NetEase），从 WinGet 官方索引里查找包 ID。"
                       FontSize="11"
                       Foreground="{StaticResource BrushTextMuted}"
                       TextWrapping="Wrap" />

            <!-- 搜索行 -->
            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Style="{StaticResource InputBox}"
                         Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="搜索关键词" />
                <Button Grid.Column="1"
                        Style="{StaticResource SecondaryButton}"
                        Width="100"
                        Margin="8,0,0,0"
                        Content="搜索"
                        IsDefault="True"
                        AutomationProperties.Name="搜索"
                        Click="BtnSearch_Click" />
            </Grid>

            <!-- 状态文字 -->
            <TextBlock Grid.Row="2"
                       Text="{Binding StatusText}"
                       FontSize="11"
                       Foreground="{StaticResource BrushTextMuted}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"
                       Visibility="{Binding HasStatusText, Converter={StaticResource BoolToVis}}" />

            <!-- 搜索中进度 -->
            <ProgressBar Grid.Row="3"
                         Style="{StaticResource InputProgress}"
                         Height="2"
                         IsIndeterminate="True"
                         Margin="0,8,0,0"
                         Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}" />

            <!-- 结果列表 -->
            <Border Grid.Row="4"
                    Background="{StaticResource BrushBg0}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="6"
                    Margin="0,10,0,0">
                <ListBox x:Name="ResultsList"
                         Style="{StaticResource ListBoxClean}"
                         ItemContainerStyle="{StaticResource SearchResultItem}"
                         ItemsSource="{Binding Results}"
                         Height="380"
                         AutomationProperties.Name="搜索结果">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="13"
                                               Foreground="{StaticResource BrushText}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Name}" />
                                    <TextBlock Text="{Binding Id}"
                                               FontFamily="{StaticResource FontFamilyMono}"
                                               FontSize="11"
                                               Foreground="{StaticResource BrushAccent}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Id}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Version}"
                                           FontSize="11"
                                           Foreground="{StaticResource BrushTextSecondary}"
                                           VerticalAlignment="Center"
                                           Margin="14,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- 底部按钮 -->
            <StackPanel Grid.Row="5"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,14,0,0">
                <Button Style="{StaticResource PrimaryButton}"
                        MinWidth="96"
                        Content="确定"
                        AutomationProperties.Name="确定"
                        Click="BtnOk_Click" />
                <Button Style="{StaticResource SecondaryButton}"
                        MinWidth="96"
                        Content="取消"
                        Margin="10,0,0,0"
                        AutomationProperties.Name="取消"
                        Click="BtnCancel_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
