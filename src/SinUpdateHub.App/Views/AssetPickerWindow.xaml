<Window x:Class="SinUpdateHub.App.Views.AssetPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="选择安装包"
        Width="640"
        Height="560"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource BrushBg0}"
        Style="{StaticResource WindowBaseStyle}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid Background="{StaticResource BrushBg0}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="16,0,0,0">
                <Border Width="22" Height="22" CornerRadius="6" Background="{StaticResource BrushAccentGradient}">
                    <TextBlock Text="S"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="选择安装包"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource BrushText}"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0">
                <Button Style="{StaticResource CloseTitleBarButton}"
                        Content="&#xE711;"
                        ToolTip="关闭"
                        Click="BtnClose_Click" />
            </StackPanel>
        </Grid>

        <!-- 内容 -->
        <Grid Grid.Row="1" Margin="24,10,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" VerticalAlignment="Center">
                <Run Text="当前最新版本："
                     FontSize="13"
                     Foreground="{StaticResource BrushTextSecondary}" /><Run Text="{Binding VersionText, Mode=OneWay}"
                                                                            FontSize="16"
                                                                            FontWeight="SemiBold"
                                                                            Foreground="{StaticResource BrushAccent}" />
            </TextBlock>

            <TextBlock Grid.Row="1"
                       Text="{Binding HintText}"
                       FontSize="11"
                       Foreground="{StaticResource BrushTextMuted}"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0" />

            <Border Grid.Row="2"
                    Style="{StaticResource CardBorder}"
                    Padding="6"
                    Margin="0,14,0,0">
                <ListBox x:Name="CandidateList"
                         Style="{StaticResource ListBoxClean}"
                         Height="300">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Name}"
                                           FontSize="13"
                                           Foreground="{StaticResource BrushText}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Size, StringFormat={}{0:N0} B}"
                                           FontSize="11"
                                           Foreground="{StaticResource BrushTextMuted}"
                                           VerticalAlignment="Center"
                                           Margin="14,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0">
                <Button Style="{StaticResource PrimaryButton}"
                        MinWidth="96"
                        Content="确定"
                        Click="BtnOk_Click"  AutomationProperties.Name="确定" />
                <Button Style="{StaticResource SecondaryButton}"
                        MinWidth="96"
                        Content="取消"
                        Margin="10,0,0,0"
                        Click="BtnCancel_Click"  AutomationProperties.Name="取消" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
