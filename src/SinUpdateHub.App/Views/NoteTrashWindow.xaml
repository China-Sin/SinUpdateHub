<Window x:Class="SinUpdateHub.App.Views.NoteTrashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="SinNote 回收站"
        Width="700"
        Height="540"
        MinWidth="580"
        MinHeight="420"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource BrushBg0}"
        Style="{StaticResource WindowBaseStyle}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BrushBorderStrong}" BorderThickness="1">
        <Grid Background="{StaticResource BrushBg0}">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Background="{StaticResource BrushBg1}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Margin="16,0,0,0">
                    <TextBlock Text="&#xE74D;"
                               FontFamily="{StaticResource FontFamilyIcon}"
                               FontSize="15"
                               Foreground="{StaticResource BrushAccent}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="SinNote 回收站"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushText}"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                    <TextBlock Text="{Binding TrashSummaryText}"
                               FontSize="11.5"
                               Foreground="{StaticResource BrushTextMuted}"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0">
                    <Button Style="{StaticResource CloseTitleBarButton}"
                            Click="Close_Click"
                            ToolTip="关闭"
                            AutomationProperties.Name="关闭">
                        <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource FontFamilyIcon}" FontSize="10" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 顶部说明与清空操作 -->
            <Border Grid.Row="1"
                    Background="{StaticResource BrushBg1}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="0,1,0,1"
                    Padding="16,10">
                <Grid>
                    <TextBlock Text="删除的分区与笔记页会保留 30 天，到期自动清理；点击「还原」可放回原分区（若原分区已删将自动重建）。"
                               FontSize="12"
                               Foreground="{StaticResource BrushTextSecondary}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <Button Style="{StaticResource DangerGhostButton}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Height="30"
                            MinHeight="30"
                            Padding="12,0"
                            Command="{Binding EmptyTrashCommand}"
                            AutomationProperties.Name="清空回收站">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ButtonGlyph}" Text="&#xE74D;" />
                            <TextBlock Text="清空回收站" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- 回收站列表 -->
            <Grid Grid.Row="2" Margin="16,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding HasTrashItems, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding TrashItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BrushBg1}"
                                        BorderBrush="{StaticResource BrushBorder}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14,11"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 左侧色条 -->
                                        <Border Grid.Column="0"
                                                Width="4"
                                                CornerRadius="2"
                                                Background="{Binding AccentColorHex, Converter={StaticResource HexToBrush}}"
                                                Margin="0,2,12,2" />

                                        <!-- 中间信息 -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="{StaticResource BrushBg2}"
                                                        BorderBrush="{StaticResource BrushBorderStrong}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="6,1"
                                                        Margin="0,0,8,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TypeBadgeText}"
                                                               FontSize="10.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource BrushTextSecondary}" />
                                                </Border>
                                                <TextBlock Text="{Binding DisplayTitle}"
                                                           FontSize="13.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource BrushText}"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="320"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <TextBlock Text="{Binding OriginInfoText}"
                                                           FontSize="11.5"
                                                           Foreground="{StaticResource BrushTextSecondary}" />
                                                <TextBlock Text="  ·  "
                                                           FontSize="11.5"
                                                           Foreground="{StaticResource BrushTextMuted}" />
                                                <TextBlock Text="{Binding DeletedInfoText}"
                                                           FontSize="11.5"
                                                           Foreground="{StaticResource BrushTextMuted}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- 右侧操作按钮 -->
                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    Margin="12,0,0,0">
                                            <Button Style="{StaticResource SecondaryButton}"
                                                    Height="30"
                                                    MinHeight="30"
                                                    Padding="12,0"
                                                    Command="{Binding DataContext.RestoreTrashItemCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                    CommandParameter="{Binding}"
                                                    AutomationProperties.Name="还原">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource ButtonGlyph}" Text="&#xE777;" />
                                                    <TextBlock Text="还原" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource DangerGhostButton}"
                                                    Height="30"
                                                    MinHeight="30"
                                                    Padding="10,0"
                                                    Margin="6,0,0,0"
                                                    Command="{Binding DataContext.DeleteTrashItemPermanentlyCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                    CommandParameter="{Binding}"
                                                    AutomationProperties.Name="彻底删除">
                                                <TextBlock Text="彻底删除" VerticalAlignment="Center" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 空状态 -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding HasNoTrashItems, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="&#xE74D;"
                               FontFamily="{StaticResource FontFamilyIcon}"
                               FontSize="34"
                               Foreground="{StaticResource BrushTextMuted}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="回收站为空"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextSecondary}"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,4" />
                    <TextBlock Text="删除的分区和笔记页会暂时存放在这里"
                               FontSize="12"
                               Foreground="{StaticResource BrushTextMuted}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- 底部关闭按钮 -->
            <Border Grid.Row="3"
                    Background="{StaticResource BrushBg1}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="0,1,0,0"
                    Padding="16,10">
                <Button Style="{StaticResource GhostButton}"
                        HorizontalAlignment="Right"
                        MinWidth="84"
                        Click="Close_Click"
                        AutomationProperties.Name="关闭回收站">
                    <TextBlock Text="关闭" VerticalAlignment="Center" />
                </Button>
            </Border>
        </Grid>
    </Border>
</Window>
