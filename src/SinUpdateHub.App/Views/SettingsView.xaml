<UserControl x:Class="SinUpdateHub.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:SinUpdateHub.App.Controls"
             mc:Ignorable="d"
             d:DesignWidth="980"
             d:DesignHeight="700"
             Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== 可滚动内容 ==================== -->
        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="24,18,24,24">
            <StackPanel>
                <!-- 页面标题 -->
                <TextBlock Style="{StaticResource PageTitle}" Text="设置" />
                <TextBlock Style="{StaticResource PageSubtitle}" Text="网络、Token、下载与 WinGet 索引" />

                <!-- ==================== 分组：网络 ==================== -->
                <Border Background="{StaticResource BrushBg1}"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16"
                        Margin="0,16,0,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="网络" />

                        <!-- 代理模式 -->
                        <TextBlock Style="{StaticResource FieldLabel}" Text="代理模式" />
                        <ComboBox Style="{StaticResource InputCombo}"
                                  Width="320"
                                  HorizontalAlignment="Left"
                                  ItemsSource="{Binding ProxyModes}"
                                  DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedProxyMode, Mode=TwoWay}"
                                  AutomationProperties.Name="代理模式" />
                        <TextBlock Style="{StaticResource FieldHint}"
                                   Text="{Binding SelectedProxyMode.Hint}" />

                        <!-- 自定义代理地址 -->
                        <StackPanel Margin="0,12,0,0"
                                    Visibility="{Binding IsCustomProxy, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="代理地址" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Style="{StaticResource InputBox}"
                                         Text="{Binding ProxyUrl, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="代理地址" />
                                <Button Grid.Column="1"
                                        Style="{StaticResource GhostButton}"
                                        Height="34"
                                        MinHeight="34"
                                        Margin="8,0,0,0"
                                        Content="清除"
                                        Command="{Binding ResetProxyCommand}"
                                        AutomationProperties.Name="清除代理地址" />
                            </Grid>
                            <TextBlock Style="{StaticResource FieldHint}" Text="例如 http://127.0.0.1:7897" />
                        </StackPanel>

                        <!-- 测试网络：结果紧贴按钮下方，不用滚动就能看到 -->
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Style="{StaticResource SecondaryButton}"
                                    Command="{Binding TestNetworkCommand}"
                                    AutomationProperties.Name="测试网络">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource ButtonGlyph}" Text="&#xE895;" />
                                    <TextBlock Text="测试网络" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Border Background="{StaticResource BrushBg2}"
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,8"
                                Margin="0,10,0,0"
                                Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding StatusMessage}"
                                       FontSize="12"
                                       Foreground="{StaticResource BrushInfo}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <!-- GitHub API Token（掩码显示 + 验证） -->
                        <TextBlock Style="{StaticResource SectionHeader}"
                                   Text="GitHub API Token"
                                   Margin="0,20,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PasswordBox Grid.Column="0"
                                         Style="{StaticResource InputPassword}"
                                         controls:PasswordBoxHelper.BindPassword="{Binding GitHubToken, Mode=TwoWay}"
                                         AutomationProperties.Name="GitHub API Token" />
                            <Button Grid.Column="1"
                                    Style="{StaticResource GhostButton}"
                                    Height="34"
                                    MinHeight="34"
                                    Margin="8,0,0,0"
                                    Command="{Binding VerifyTokenCommand}"
                                    AutomationProperties.Name="验证 Token">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource ButtonGlyph}" Text="&#xE73E;" />
                                    <TextBlock Text="验证" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2"
                                    Style="{StaticResource GhostButton}"
                                    Height="34"
                                    MinHeight="34"
                                    Margin="4,0,0,0"
                                    Command="{Binding OpenTokenPageCommand}"
                                    AutomationProperties.Name="打开 Token 页面">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource ButtonGlyph}" Text="&#xE8A7;" />
                                    <TextBlock Text="打开 Token 页面" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock Text="{Binding TokenStatus}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   Visibility="{Binding HasTokenStatus, Converter={StaticResource BoolToVis}}">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TokenOk}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource BrushSuccess}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Style="{StaticResource FieldHint}"
                                   Text="Token 只需 read-only API 权限；不填也能用，但匿名请求限 60 次/小时（按 IP 算）。" />
                    </StackPanel>
                </Border>

                <!-- ==================== 分组：行为 ==================== -->
                <Border Background="{StaticResource BrushBg1}"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="行为" />

                        <CheckBox Style="{StaticResource InputCheck}"
                                  Content="启动时自动检查更新"
                                  IsChecked="{Binding AutoCheckOnStartup, Mode=TwoWay}"
                                  Margin="0,0,0,10" />
                        <CheckBox Style="{StaticResource InputCheck}"
                                  Content="检查时包含 GitHub 预发布版本"
                                  IsChecked="{Binding IncludePrerelease, Mode=TwoWay}"
                                  Margin="0,0,0,10" />
                        <CheckBox Style="{StaticResource InputCheck}"
                                  Content="以管理员身份运行安装器（UAC 提权）"
                                  IsChecked="{Binding RunInstallerAsAdmin, Mode=TwoWay}" />

                        <TextBlock Style="{StaticResource FieldLabel}"
                                   Text="下载缓存目录"
                                   Margin="0,16,0,5" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Style="{StaticResource InputBox}"
                                     Text="{Binding DownloadDir, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="下载缓存目录" />
                            <Button Grid.Column="1"
                                    Style="{StaticResource SecondaryButton}"
                                    Height="34"
                                    MinHeight="34"
                                    Margin="8,0,0,0"
                                    Command="{Binding BrowseDownloadDirCommand}"
                                    AutomationProperties.Name="浏览下载缓存目录">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource ButtonGlyph}" Text="&#xE838;" />
                                    <TextBlock Text="浏览" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ==================== 分组：WinGet 本地索引 ==================== -->
                <Border Background="{StaticResource BrushBg1}"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="WinGet 本地索引" />
                        <TextBlock Text="{Binding CatalogStatusText}"
                                   FontSize="11"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Style="{StaticResource SecondaryButton}"
                                    Command="{Binding UpdateCatalogCommand}"
                                    AutomationProperties.Name="更新索引">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource ButtonGlyph}" Text="&#xE896;" />
                                    <TextBlock Text="更新索引" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <ProgressBar Style="{StaticResource InputProgress}"
                                     Height="4"
                                     Minimum="0"
                                     Maximum="1"
                                     Value="{Binding CatalogProgress, Mode=OneWay}"
                                     Margin="0,10,0,0"
                                     Visibility="{Binding IsCatalogBusyVisible, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Style="{StaticResource FieldHint}"
                                   Text="下载一次（约 21 MB）后，可按软件名称搜包 ID，WinGet 检查也不消耗 GitHub API 额度。" />
                    </StackPanel>
                </Border>

                <!-- ==================== 分组：关于 ==================== -->
                <Border Background="{StaticResource BrushBg1}"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="关于" />
                        <TextBlock Text="{Binding VersionText}"
                                   FontSize="11"
                                   Foreground="{StaticResource BrushTextMuted}" />
                        <TextBlock Text="{Binding DataFileText}"
                                   FontSize="11"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                        <TextBlock Text="{Binding SettingsFileText}"
                                   FontSize="11"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ==================== 底部固定操作条（不随滚动） ==================== -->
        <Border Grid.Row="1"
                Background="{StaticResource BrushBg0}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,1,0,0"
                Padding="24,12,24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="修改后点「保存」生效；点「撤销」恢复为已保存的设置。"
                           FontSize="11"
                           Foreground="{StaticResource BrushTextMuted}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource PrimaryButton}"
                            MinWidth="96"
                            Command="{Binding SaveCommand}"
                            AutomationProperties.Name="保存设置">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ButtonGlyph}" Text="&#xE74E;" />
                            <TextBlock Text="保存" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}"
                            MinWidth="96"
                            Margin="10,0,0,0"
                            Command="{Binding CancelCommand}"
                            AutomationProperties.Name="撤销修改">
                        <TextBlock Text="撤销" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
