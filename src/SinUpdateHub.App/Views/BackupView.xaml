<UserControl x:Class="SinUpdateHub.App.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:SinUpdateHub.App.Controls"
             mc:Ignorable="d"
             d:DesignWidth="1160"
             d:DesignHeight="760"
             Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== 可滚动内容 ==================== -->
        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="24,18,24,24">
            <StackPanel>
                <!-- 页面标题 -->
                <TextBlock Style="{StaticResource PageTitle}" Text="备份与恢复" />
                <TextBlock Style="{StaticResource PageSubtitle}" Text="左侧配置 WebDAV 网盘连接，右侧执行远端备份/恢复及本地 JSON 导入导出" />

                <!-- 淡紫说明条 -->
                <Border Background="{StaticResource BrushAccentSoft}"
                        BorderBrush="{StaticResource BrushAccent}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,12"
                        Margin="0,16,0,14">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE753;"
                                   FontFamily="{StaticResource FontFamilyIcon}"
                                   FontSize="16"
                                   Foreground="{StaticResource BrushAccent}"
                                   VerticalAlignment="Top"
                                   Margin="0,1,10,0" />
                        <TextBlock TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{StaticResource BrushTextSecondary}">
                            <Run Text="WebDAV 备份：左侧填好网盘地址后点「测试连接」验证，再在右侧点「立即备份」同步软件清单与 SinNote；换电脑时点「刷新列表」→ 选中备份 →「恢复选中备份」即可找回。" /><LineBreak />
                            <Run Text="本地文件：可在右下角直接导出 JSON 或从本地 JSON 导入恢复。" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- ==================== 左右分栏主体 ==================== -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- ============ 左侧：WebDAV 配置 ============ -->
                    <Border Grid.Column="0"
                            Background="{StaticResource BrushBg1}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="18"
                            VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeader}" Text="WebDAV 连接设置" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="WebDAV 地址" />
                            <TextBox Style="{StaticResource InputBox}"
                                     Text="{Binding WebDavUrl, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="WebDAV 地址" />
                            <TextBlock Style="{StaticResource FieldHint}"
                                       Text="例如 https://dav.jianguoyun.com/dav/（坚果云）、https://你的群晖地址:5006/" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="账号" Margin="0,14,0,5" />
                            <TextBox Style="{StaticResource InputBox}"
                                     Text="{Binding WebDavUser, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="WebDAV 账号" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="密码 / 应用密码" Margin="0,14,0,5" />
                            <Grid>
                                <PasswordBox Style="{StaticResource InputPassword}"
                                             controls:PasswordBoxHelper.BindPassword="{Binding WebDavPassword, Mode=TwoWay}"
                                             AutomationProperties.Name="WebDAV 密码"
                                             Visibility="{Binding ShowPassword, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                <TextBox Style="{StaticResource InputBox}"
                                         Text="{Binding WebDavPassword, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="WebDAV 密码明文"
                                         Visibility="{Binding ShowPassword, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                            <CheckBox Style="{StaticResource InputCheck}"
                                      Content="显示密码（核对是否粘贴完整）"
                                      IsChecked="{Binding ShowPassword}"
                                      Margin="0,7,0,0" />

                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Style="{StaticResource FieldHint}"
                                           Text="坚果云不能用登录密码，必须用「应用密码」（网页版 → 账户信息 → 安全选项 → 添加应用 → 生成应用密码）；账号填完整邮箱。"
                                           Margin="0" />
                                <Button Style="{StaticResource GhostButton}"
                                        Height="26"
                                        MinHeight="26"
                                        Padding="8,0"
                                        Margin="0,4,0,0"
                                        HorizontalAlignment="Left"
                                        Command="{Binding OpenHelpCommand}"
                                        AutomationProperties.Name="如何获取应用密码">
                                    <TextBlock Text="如何获取应用密码 →" FontSize="11" VerticalAlignment="Center" />
                                </Button>
                            </StackPanel>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- 远程目录 -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="远程目录" />
                                    <TextBox Style="{StaticResource InputBox}"
                                             Text="{Binding WebDavFolder, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="远程目录" />
                                </StackPanel>

                                <!-- 保留备份数 -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="保留备份数" />
                                    <TextBox Style="{StaticResource InputBox}"
                                             Text="{Binding KeepBackups, UpdateSourceTrigger=LostFocus}"
                                             AutomationProperties.Name="保留备份数" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Style="{StaticResource SecondaryButton}"
                                        Command="{Binding TestConnectionCommand}"
                                        AutomationProperties.Name="测试连接">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource ButtonGlyph}" Text="&#xE774;" />
                                        <TextBlock Text="测试连接" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ============ 右侧：备份 / 恢复 / 导入导出 ============ -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Top">
                        <!-- 远端备份与恢复 -->
                        <Border Background="{StaticResource BrushBg1}"
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="18"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="备份与恢复" />

                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Style="{StaticResource PrimaryButton}"
                                            Command="{Binding BackupNowCommand}"
                                            AutomationProperties.Name="立即备份">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource ButtonGlyph}" Text="&#xE898;" />
                                            <TextBlock Text="立即备份" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource GhostButton}"
                                            Margin="8,0,0,0"
                                            Command="{Binding RefreshListCommand}"
                                            AutomationProperties.Name="刷新列表">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource ButtonGlyph}" Text="&#xE72C;" />
                                            <TextBlock Text="刷新列表" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Text="{Binding LastBackupText}"
                                               FontSize="11"
                                               Foreground="{StaticResource BrushTextMuted}" />
                                    <TextBlock Text="{Binding EntryCountText}"
                                               FontSize="11"
                                               Foreground="{StaticResource BrushTextSecondary}"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,0" />
                                </StackPanel>

                                <!-- 自动定时备份 -->
                                <Border Background="{StaticResource BrushBg0}"
                                        BorderBrush="{StaticResource BrushBorder}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12,10"
                                        Margin="0,12,0,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox Style="{StaticResource InputCheck}"
                                                      Content="自动定时备份"
                                                      IsChecked="{Binding AutoBackupEnabled}"
                                                      VerticalAlignment="Center"
                                                      AutomationProperties.Name="自动定时备份" />
                                            <TextBlock Text="每隔"
                                                       FontSize="12"
                                                       Foreground="{StaticResource BrushTextSecondary}"
                                                       VerticalAlignment="Center"
                                                       Margin="14,0,6,0" />
                                            <TextBox Style="{StaticResource InputBox}"
                                                     Width="54"
                                                     Height="26"
                                                     MinHeight="26"
                                                     Padding="6,2"
                                                     HorizontalContentAlignment="Center"
                                                     VerticalContentAlignment="Center"
                                                     IsEnabled="{Binding AutoBackupEnabled}"
                                                     Text="{Binding AutoBackupIntervalHours, UpdateSourceTrigger=LostFocus}"
                                                     AutomationProperties.Name="自动备份间隔小时数" />
                                            <TextBlock Text="小时"
                                                       FontSize="12"
                                                       Foreground="{StaticResource BrushTextSecondary}"
                                                       VerticalAlignment="Center"
                                                       Margin="6,0,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding AutoBackupStatusText}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource BrushTextMuted}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- 远端备份列表 -->
                                <Border Background="{StaticResource BrushBg0}"
                                        BorderBrush="{StaticResource BrushBorder}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="6"
                                        Margin="0,12,0,0">
                                    <ListBox Style="{StaticResource ListBoxClean}"
                                             Height="210"
                                             ItemsSource="{Binding Backups}"
                                             SelectedItem="{Binding SelectedBackup, Mode=TwoWay}"
                                             DisplayMemberPath="Display"
                                             AutomationProperties.Name="远端备份列表" />
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Style="{StaticResource PrimaryButton}"
                                            MinWidth="148"
                                            Command="{Binding RestoreCommand}"
                                            AutomationProperties.Name="恢复选中备份">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource ButtonGlyph}" Text="&#xE777;" />
                                            <TextBlock Text="恢复选中备份" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource DangerGhostButton}"
                                            Margin="8,0,0,0"
                                            Command="{Binding DeleteBackupCommand}"
                                            AutomationProperties.Name="删除选中备份">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource ButtonGlyph}" Text="&#xE74D;" />
                                            <TextBlock Text="删除选中备份" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 本地导入 / 导出 -->
                        <Border Background="{StaticResource BrushBg1}"
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="18">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="本地导入 / 导出" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource SecondaryButton}"
                                            Command="{Binding ExportLocalCommand}"
                                            AutomationProperties.Name="导出 JSON">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource ButtonGlyph}" Text="&#xE896;" />
                                            <TextBlock Text="导出 JSON" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource SecondaryButton}"
                                            Margin="8,0,0,0"
                                            Command="{Binding ImportLocalCommand}"
                                            AutomationProperties.Name="导入 JSON">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource ButtonGlyph}" Text="&#xE8B5;" />
                                            <TextBlock Text="导入 JSON" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Style="{StaticResource FieldHint}"
                                           Text="导入 JSON 与云端恢复均支持全选或单选指定软件条目及 SinNote 笔记页面，并可选择合并或覆盖恢复。"
                                           Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- ==================== 底部状态条（固定，状态始终可见） ==================== -->
        <Border Grid.Row="1"
                Background="{StaticResource BrushBg0}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,1,0,0"
                Padding="24,10,24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           FontSize="12"
                           Foreground="{StaticResource BrushInfo}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="16,0,0,0"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                    <ProgressBar Style="{StaticResource InputProgress}"
                                 Width="120"
                                 Height="2"
                                 IsIndeterminate="True"
                                 VerticalAlignment="Center" />
                    <TextBlock Text="处理中…"
                               FontSize="11"
                               Foreground="{StaticResource BrushTextSecondary}"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
