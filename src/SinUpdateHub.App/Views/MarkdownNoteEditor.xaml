<UserControl x:Class="SinUpdateHub.App.Views.MarkdownNoteEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d"
             d:DesignWidth="760"
             d:DesignHeight="600"
             Background="{StaticResource BrushBg0}">

    <Grid Background="{StaticResource BrushBg0}">
        <wv2:WebView2 x:Name="EditorWebView"
                      Visibility="Collapsed" />

        <StackPanel x:Name="FallbackOverlay"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Margin="24"
                    Visibility="Visible">
            <TextBlock x:Name="FallbackTitleText"
                       Text="正在加载 Typora 风格 Markdown 编辑器..."
                       FontSize="14"
                       FontWeight="Medium"
                       Foreground="{StaticResource BrushTextSecondary}"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="FallbackDetailText"
                       FontSize="12"
                       Foreground="{StaticResource BrushTextMuted}"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       MaxWidth="480"
                       TextAlignment="Center"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
