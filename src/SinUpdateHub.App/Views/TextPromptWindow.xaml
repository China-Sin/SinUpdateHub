<Window x:Class="SinUpdateHub.App.Views.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="输入名称"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource BrushBg0}"
        Style="{StaticResource WindowBaseStyle}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="5"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BrushBorderStrong}" BorderThickness="1" Background="{StaticResource BrushBg0}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock x:Name="TitleTextBlock"
                           Text="输入名称"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource BrushText}"
                           VerticalAlignment="Center"
                           Margin="16,0,44,0" />
                <Button Style="{StaticResource CloseTitleBarButton}"
                        HorizontalAlignment="Right"
                        Height="40"
                        Width="40"
                        Content="&#xE711;"
                        ToolTip="关闭"
                        Click="Cancel_Click" />
            </Grid>

            <!-- 内容区 -->
            <StackPanel Grid.Row="1" Margin="20,8,20,16">
                <TextBlock x:Name="PromptLabelTextBlock"
                           Style="{StaticResource FieldLabel}"
                           Text="名称" />
                <TextBox x:Name="InputTextBox"
                         Style="{StaticResource InputBox}"
                         Margin="0,2,0,0"
                         AutomationProperties.Name="输入文本" />
            </StackPanel>

            <!-- 底部按钮 -->
            <Border Grid.Row="2"
                    Background="{StaticResource BrushBg1}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="0,1,0,0"
                    Padding="20,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource SecondaryButton}"
                            Content="取消"
                            MinWidth="82"
                            IsCancel="True"
                            Click="Cancel_Click" />
                    <Button Style="{StaticResource PrimaryButton}"
                            Content="确定"
                            MinWidth="88"
                            Margin="10,0,0,0"
                            IsDefault="True"
                            Click="Confirm_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
