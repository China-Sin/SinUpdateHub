                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushBg2}" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource BrushBorderStrong}" />
                            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushAccent}" />
                <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}" />
                <Setter Property="Foreground" Value="#FFFFFF" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

